# Environment variables with secrets
.env
.env.local
.env.*.local
.env.production

# ============================================================================
# BUILD AND DEPLOYMENT FILES
# ============================================================================

# Build output
build-output/
*.zip
dist/

# Dependencies
venv/
env/
ENV/
.venv
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
virtualenv/
.virtualenvs/

