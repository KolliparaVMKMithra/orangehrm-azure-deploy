# Azure Deployment Configuration Template
# Copy this file to .env and fill in all values before running deployment

# ============================================================================
# AZURE SUBSCRIPTION & AUTHENTICATION
# ============================================================================

# Your Azure Subscription ID (Get from Azure Portal)
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Service Principal Tenant ID (from 'az ad sp create-for-rbac' output)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Service Principal Client ID / AppId (from 'az ad sp create-for-rbac' output)
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Service Principal Password / Secret (from 'az ad sp create-for-rbac' output)
# ⚠️ IMPORTANT: Keep this secret! Never commit to git!
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# AZURE RESOURCE CONFIGURATION
# ============================================================================

# Resource Group Name (will be created if doesn't exist)
RESOURCE_GROUP_NAME=orangehrm-rg

# Azure Region/Location (eastus, westus, northeurope, westeurope, southeastasia, etc.)
AZURE_LOCATION=eastus

# ============================================================================
# APP SERVICE CONFIGURATION
# ============================================================================

# App Service Plan name
APP_SERVICE_PLAN_NAME=orangehrm-plan

# App Service name (must be globally unique across Azure)
# Recommendation: Use something like 'orangehrm-yourname-12345'
APP_SERVICE_NAME=orangehrm-app

# App Service Pricing Tier
# Free: F1, Shared: D1
# Basic: B1, B2, B3
# Standard: S1, S2, S3 (recommended for production)
# Premium: P1, P2, P3
APP_SERVICE_SKU=B2

# ============================================================================
# DATABASE CONFIGURATION (Azure Database for MySQL)
# ============================================================================

# MySQL Server name (must be globally unique)
# Recommendation: Use something like 'orangehrm-yourname-12345'
DB_SERVER_NAME=orangehrm-mysql

# Database name
DB_NAME=orangehrm

# Database admin username
DB_ADMIN_USER=orangeadmin

# Database admin password
# ⚠️ IMPORTANT: Use a strong password!
# Requirements:
# - Minimum 8 characters
# - Mix of uppercase, lowercase, numbers, and special characters
# - Examples: Or@ngeH1rM2024!, AzureSQL#Pass123
DB_ADMIN_PASSWORD=YourSecurePassword123!@#

# MySQL Server SKU (pricing tier)
# Burstable: B_Standard_B1ms, B_Standard_B2s (recommended for dev/test)
# General Purpose: GP_Standard_D2s, GP_Standard_D4s
# Memory Optimized: MO_Standard_E2s, MO_Standard_E4s
DB_SKU=B_Standard_B1ms

# MySQL Version (8.0 or 5.7)
DB_VERSION=8.0

# Database Storage Size in MB
# Minimum: 32768 (32GB)
# Maximum: 1048576 (1TB)
DB_STORAGE_SIZE=32768

# ============================================================================
# STORAGE ACCOUNT CONFIGURATION
# ============================================================================

# Storage Account name (must be globally unique, lowercase only, 3-24 chars)
# Recommendation: Use something like 'orangehrm12345'
STORAGE_ACCOUNT_NAME=orangehrmsa

# Container name for storing application files/uploads
STORAGE_CONTAINER_NAME=orangehrm-files

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# PHP Version (8.2 recommended for best compatibility)
# Supported: 7.4, 8.0, 8.1, 8.2
PHP_VERSION=8.2

# Node.js Version (for frontend build)
# Supported: 14, 16, 18, 20
NODE_VERSION=18

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================

# Repository path (relative to this script's location)
# Usually '.' or '..'
APP_REPO_PATH=..

# Git branch to deploy
DEPLOY_BRANCH=main

# Deployment method: 'zip' (recommended) or 'git'
DEPLOYMENT_METHOD=zip

# ============================================================================
# BUILD SETTINGS
# ============================================================================

# Enable application build (true/false)
ENABLE_BUILD=true

# Install Composer dependencies (true/false)
COMPOSER_INSTALL=true

# Install NPM dependencies (true/false)
NPM_INSTALL=true

# Production build (true/false) - minifies and optimizes
PROD_BUILD=true

# Create ZIP package for deployment (true/false)
ZIP_DEPLOYMENT=true

# ============================================================================
# ADDITIONAL SETTINGS
# ============================================================================

# Publish profile path (for VS Code deployment, optional)
PUBLISH_PROFILE_PATH=

# Database host (for local database testing, usually not needed for Azure)
DB_HOST=localhost

# Database port
DB_PORT=3306

# ============================================================================
# NOTES FOR EACH SETTING
# ============================================================================

# 1. Get Azure Subscription ID:
#    az account show --query id
#
# 2. Create Service Principal:
#    az ad sp create-for-rbac --name orangehrm-deployer --role Contributor
#    This returns: appId (CLIENT_ID), password (CLIENT_SECRET), tenant (TENANT_ID)
#
# 3. Storage Account Name:
#    - Must be 3-24 characters
#    - Lowercase letters and numbers only
#    - Must be globally unique
#    - Example: orangehrm12345abc
#
# 4. App Service Name:
#    - Must be globally unique
#    - Can contain letters, numbers, and hyphens
#    - Examples: orangehrm-company1, orangehrm-prod-v2
#
# 5. Database Server Name:
#    - Must be globally unique
#    - Can contain letters, numbers, and hyphens
#    - Examples: orangehrm-mysql-prod, orangehrm-db-company1
#
# 6. Password Requirements for MySQL:
#    - Minimum 8 characters
#    - Must contain uppercase, lowercase, number, and special character
#    - Cannot contain username
#    - Special characters allowed: !@#$%^&*()-_=+
#
# 7. Location Codes (popular options):
#    eastus           - Virginia, USA
#    westus           - California, USA
#    northeurope      - Ireland
#    westeurope       - Netherlands
#    southeastasia    - Singapore
#    eastasia         - Hong Kong
#    australiaeast    - Sydney
#    japaneast        - Tokyo
#    canadacentral    - Toronto
#
# 8. Pricing Tiers (monthly estimate):
#    B2 App Service   - $15-30
#    B1ms Database    - $15-30
#    Storage Account  - $5-10
#    Total (minimum)  - ~$35-70/month

# ============================================================================
# SECURITY REMINDERS
# ============================================================================

# ⚠️ IMPORTANT SECURITY NOTES:
#
# 1. NEVER commit this file to version control!
#    Add '.env' to .gitignore
#
# 2. NEVER share AZURE_CLIENT_SECRET with anyone!
#    Treat it like a password
#
# 3. NEVER share DB_ADMIN_PASSWORD with anyone!
#
# 4. Rotate credentials regularly (every 3-6 months)
#
# 5. Use strong, unique passwords
#
# 6. Enable MFA on Azure account
#
# 7. Monitor Azure bills for unexpected costs
#
# 8. Review and adjust access controls in Azure Portal

# ============================================================================
# HOW TO USE THIS FILE
# ============================================================================

# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit the .env file with your values:
#    - Open in text editor
#    - Replace all xxx... placeholders
#    - Save file
#
# 3. Verify the file is in .gitignore:
#    # Check if .gitignore exists
#    # Add this line if not present: .env
#
# 4. Run deployment:
#    python deployment_orchestrator.py
#
# 5. Monitor the process:
#    - Check console output
#    - Check logs/deployment.log for details
#    - Verify resources in Azure Portal

# ============================================================================
